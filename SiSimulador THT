  // Magnus–Tetens (T em °C, RH em fração 0–1)
  function pontoOrvalho(T, RH) {
    const a = 17.27, b = 237.7;
    const gamma = (a * T) / (b + T) + Math.log(RH);
    return (b * gamma) / (a - gamma);
  }

  // Pressão de vapor de saturação (Pa)
  function pSat(T) {
    const Tc = T;
    return 610.78 * Math.exp((17.27 * Tc) / (Tc + 237.3));
  }

  function renderPizzaGrid() {
    // Destroy existing chart instances before clearing DOM
    Object.keys(chartInstances).forEach(id => {
      chartInstances[id].destroy();
      delete chartInstances[id];
    });

    const grid = document.getElementById('pizzaGrid');
    grid.innerHTML = '';
    const k = simulacoes.length;
    if (!k) return;
    const n = Math.ceil(k / 3) * 3;

    for (let i = 0; i < n; i++) {
      const cell = document.createElement('div');
      cell.className = 'pizza-cell';
      if (i < k) {
        const sim = simulacoes[i];
        const origem = sim.origemBiblioteca ? ' (tipo SCE/ADENE)' : '';
        cell.innerHTML = `
          <div class="pizza-title">${escHTML(sim.nome)}${origem} — ${sim.tipo}, Zona ${sim.zona}</div>
          <div class="charts-row">
            <canvas id="pizzaU_${i}"></canvas>
            <div class="svg-wrapper" id="svg_${i}"></div>
          </div>
          <div class="higro-note" id="note_${i}"></div>
          <div class="credit">Tulio Cunha — Gestão de Projetos</div>
        `;
        grid.appendChild(cell);
        desenharPizzaU(`pizzaU_${i}`, sim);
        desenharSVG(`svg_${i}`, sim);
        escreverNotaHigro(`note_${i}`, sim);
      } else {
        cell.innerHTML = `<div class="pizza-title">Slot disponível</div>`;
        grid.appendChild(cell);
      }
    }
  }

  function desenharPizzaU(canvasId, sim) {
    if (chartInstances[canvasId]) {
      chartInstances[canvasId].destroy();
      delete chartInstances[canvasId];
    }
    const ctx = document.getElementById(canvasId).getContext('2d');
    const U_lim = U_LIMITES[sim.tipo][sim.zona];
    const data = {
      labels: ['U calculado', 'Limite REH'],
      datasets: [{
        data: [sim.U, U_lim],
        backgroundColor: ['#1f6f8b', '#a5d8ff']
      }]
    };
    chartInstances[canvasId] = new Chart(ctx, {
      type: 'pie',
      data,
      options: {
        plugins: { legend: { display: false } },
        responsive: true,
        maintainAspectRatio: false
      }
    });
  }

  function desenharSVG(containerId, sim) {
    const container = document.getElementById(containerId);
    const vertical = (sim.tipo === 'parede' || sim.tipo === 'cobertura');
    const width = 220, height = 220;
    const totalEsp = sim.camadas.reduce((s,c)=>s+c.d,0);
    let offset = 0;
    let rects = '';

    sim.camadas.forEach((c, idx) => {
      const frac = c.d / totalEsp;

      if (vertical) {
        const h = frac * (height - 40);
        rects += `
          <rect x="40" y="${20 + offset}" width="${width - 80}" height="${h}"
                fill="none" stroke="#111" stroke-width="1"/>
          <text x="45" y="${20 + offset + h/2}" font-size="9" fill="#111">
            ${escHTML(c.material)} — ${(c.d*1000).toFixed(0)} mm
          </text>
        `;
        offset += h;
      } else {
        const w = frac * (width - 80);
        rects += `
          <rect x="${40 + offset}" y="60" width="${w}" height="${height - 120}"
                fill="none" stroke="#111" stroke-width="1"/>
          <text x="${40 + offset + w/2}" y="55" font-size="9" fill="#111" text-anchor="middle">
            ${(c.d*1000).toFixed(0)} mm
          </text>
        `;
        offset += w;
      }
    });

    const escala = `
      <line x1="40" y1="${height-10}" x2="${width-40}" y2="${height-10}"
            stroke="#111" stroke-width="1"/>
      <text x="${width/2}" y="${height-2}" font-size="9" fill="#111" text-anchor="middle">
        Escala proporcional às espessuras
      </text>
    `;

    const svg = `
      <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}"
           xmlns="http://www.w3.org/2000/svg">
        <rect x="0.5" y="0.5" width="${width-1}" height="${height-1}"
              fill="none" stroke="#e5e7eb" stroke-width="1"/>
        ${rects}
        ${escala}
        <text x="${width-5}" y="${height-5}" font-size="7" fill="#999" text-anchor="end">
          Tulio Cunha — Gestão de Projetos
        </text>
      </svg>
    `;

    container.innerHTML = svg;
  }

  function escreverNotaHigro(noteId, sim) {
    const el = document.getElementById(noteId);
    const supMeses = sim.condSupMeses.length ? sim.condSupMeses.join(', ') : 'Nenhum';
    const intMeses = sim.condIntMeses.length ? sim.condIntMeses.join(', ') : 'Nenhum';

    let interfacesHtml = 'Nenhuma interface crítica identificada';
    if (sim.interfacesCriticas.length) {
      interfacesHtml = sim.interfacesCriticas.map(i => escHTML(i)).join('<br>&nbsp;&nbsp;');
    }

    let condensadoHtml = '';
    if (sim.condensadoAnual && Object.keys(sim.condensadoAnual).length > 0) {
      const items = Object.entries(sim.condensadoAnual)
        .map(([iface, Mc_anual]) => `${escHTML(iface)}: <strong>${Mc_anual.toFixed(1)} g/m²/ano</strong>`)
        .join('<br>&nbsp;&nbsp;');
      condensadoHtml = `<br>• Condensado estimado:<br>&nbsp;&nbsp;${items}`;
      const totalMc = Object.values(sim.condensadoAnual).reduce((s,v) => s+v, 0);
      if (totalMc > 0) {
        condensadoHtml += `<br>• <span style="color:var(--warn)">⚠️ Acumulação anual detectada — verificar evaporação (ISO 13788 §6)</span>`;
      }
    }

    let avisoSoloHtml = '';
    if (sim.avisoSolo) {
      avisoSoloHtml = `<br><span style="color:var(--warn)">⚠️ Análise intersticial não aplicável a pavimento sobre solo (requer ISO 13370)</span>`;
    }

    el.innerHTML = `
      <strong>Análise higrotérmica (ISO 13788):</strong><br>
      • Superficial: ${sim.condSupMeses.length ? 'Sim' : 'Não'} (${supMeses})<br>
      • Intersticial: ${sim.avisoSolo ? 'N/A' : (sim.condIntMeses.length ? 'Sim' : 'Não')} (${sim.avisoSolo ? '—' : intMeses})${avisoSoloHtml}<br>
      • Interfaces críticas: ${interfacesHtml}${condensadoHtml}<br>
      • Dias risco superficial: ${sim.diasSup} dias/ano (${sim.severidadeSup})<br>
      • Dias risco intersticial: ${sim.avisoSolo ? 'N/A' : sim.diasInt + ' dias/ano (' + sim.severidadeInt + ')'}
    `;
  }

  // --- Biblioteca: sugestão automática ---

  function verificarSugestaoBiblioteca(elementoBase) {
    if (contadorElementos === 1 || contadorElementos % 6 === 0) {
      const candidatos = filtrarBiblioteca(elementoBase);
      if (candidatos.length) {
        const box = document.getElementById('bibliotecaSugestao');
        const select = document.getElementById('bibliotecaSelect');
        select.innerHTML = '';
        candidatos.forEach((c, idx) => {
          const opt = document.createElement('option');
          opt.value = idx;
          opt.textContent = c.nome;
          select.appendChild(opt);
        });
        box.dataset.tipo = elementoBase.tipo;
        box.dataset.candidatos = JSON.stringify(candidatos);
        box.style.display = 'block';
      }
    }
  }

  function filtrarBiblioteca(elementoBase) {
    const tipo = elementoBase.tipo;
    const lista = BIBLIOTECA[tipo] || [];
    if (!lista.length) return [];

    const espUser = elementoBase.camadas.reduce((s,c)=>s+c.d,0);
    const materiaisUser = elementoBase.camadas.map(c => c.material.toLowerCase());

    return lista.filter(sol => {
      const espSol = sol.camadas.reduce((s,c)=>s+c.d,0);
      const ratioEsp = espSol / espUser;
      if (ratioEsp < 0.8 || ratioEsp > 1.2) return false;

      const materiaisSol = sol.camadas.map(c => c.material.toLowerCase());
      const temMaterialSimilar = materiaisSol.some(m =>
        materiaisUser.some(mu => mu.includes('eps') && m.includes('eps')) ||
        materiaisUser.some(mu => mu.includes('lã') && m.includes('lã')) ||
        materiaisUser.some(mu => mu.includes('tijolo') && m.includes('tijolo')) ||
        materiaisUser.some(mu => mu.includes('betão') && m.includes('betão'))
      );

      return temMaterialSimilar;
    });
  }

  function adicionarDaBiblioteca() {
    const box = document.getElementById('bibliotecaSugestao');
    const select = document.getElementById('bibliotecaSelect');
    const idx = parseInt(select.value || '0', 10);
    const candidatos = JSON.parse(box.dataset.candidatos || '[]');
    const sol = candidatos[idx];
    if (!sol) return;
    calcularElemento(true, { tipo: box.dataset.tipo, nome: sol.nome, camadas: sol.camadas });
    box.style.display = 'none';
  }

  function fecharSugestao() {
    document.getElementById('bibliotecaSugestao').style.display = 'none';
  }

  // --- Utilitários ---

  function escHTML(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // --- Exportação / Importação JSON ---

  function exportarJSON() {
    if (!simulacoes.length) { alert('Nenhuma simulação para exportar.'); return; }
    const json = JSON.stringify(simulacoes, null, 2);
    const blob = new Blob([json], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'simulacoes_THT.json';
    a.click();
    URL.revokeObjectURL(url);
  }

  function importarJSON(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const data = JSON.parse(e.target.result);
        if (!Array.isArray(data)) throw new Error('Formato inválido: esperada lista de simulações.');
        simulacoes.push(...data);
        renderPizzaGrid();
      } catch (err) {
        alert('Erro ao importar: ' + err.message);
      }
    };
    reader.readAsText(file);
    event.target.value = '';
  }
</script>
