  function calcularElemento(fromBiblioteca = false, bibliotecaEntry = null) {
    let tipo, zona, nome, camadas;

    if (!fromBiblioteca) {
      document.getElementById('camadasError').textContent = '';
      tipo = document.getElementById('tipoElemento').value;
      zona = document.getElementById('zonaClimatica').value;
      nome = document.getElementById('nomeElemento').value.trim() || 'Elemento sem nome';
      const n = parseInt(document.getElementById('numCamadas').value || '0', 10);
      if (n <= 0) return;

      const inputs = document.querySelectorAll('#camadasContainer input');
      camadas = [];
      const erros = [];
      for (let i = 0; i < n; i++) {
        const material = [...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'material').value || `Camada ${i+1}`;
        const lambda = parseFloat([...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'lambda').value || '0');
        const mu = parseFloat([...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'mu').value || '1');
        const esp_mm = parseFloat([...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'esp').value || '0');
        const d = esp_mm / 1000;
        if (lambda <= 0) erros.push(`Camada ${i+1}: λ deve ser maior que zero.`);
        if (d <= 0) erros.push(`Camada ${i+1}: espessura deve ser maior que zero.`);
        if (lambda > 0 && d > 0) {
          camadas.push({ material, lambda, mu, d, R: d / lambda });
        }
      }
      if (erros.length > 0) {
        const errDiv = document.getElementById('camadasError');
        errDiv.textContent = '';
        erros.forEach(e => {
          const div = document.createElement('div');
          div.textContent = e;
          errDiv.appendChild(div);
        });
        return;
      }
      if (!camadas.length) return;
    } else {
      tipo = bibliotecaEntry.tipo;
      zona = document.getElementById('zonaClimatica').value;
      nome = bibliotecaEntry.nome;
      camadas = bibliotecaEntry.camadas.map(c => ({
        material: c.material,
        lambda: c.lambda,
        mu: c.mu,
        d: c.d,
        R: c.d / c.lambda
      }));
    }

    const { Rsi, Rse } = R_SUP[tipo];
    const R_total = Rsi + camadas.reduce((s,c)=>s+c.R,0) + Rse;
    const U = 1 / R_total;
    const U_lim = U_LIMITES[tipo][zona];

    let classe = '';
    let badgeClass = '';
    if (U <= U_lim) { classe = 'Conforme REH'; badgeClass = 'ok'; }
    else if (U <= 0.50) { classe = 'Melhorável'; badgeClass = 'warn'; }
    else { classe = 'Não conforme (existente típico)'; badgeClass = 'danger'; }

    // Read interior conditions from UI (fall back to defaults when called from library)
    const Ti = fromBiblioteca ? 20 : parseFloat(document.getElementById('Ti').value || '20');
    const HRi = fromBiblioteca ? 0.5 : parseFloat(document.getElementById('HRi').value || '50') / 100;

    const meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
    let condSupMeses = [];
    let condIntMeses = [];
    let interfacesCriticas = new Set();
    let diasSup = 0;
    let diasInt = 0;
    const condensadoAnual = {}; // { interface_name: total_g_m2/ano }
    const avisoSolo = tipo === 'pavimento_solo';

    // Build Z_acum and R_acum (computed once, outside month loop)
    const Z_acum = [0];
    let Z_total = 0;
    camadas.forEach(c => {
      const Zi = c.mu * c.d / DELTA_0;
      Z_total += Zi;
      Z_acum.push(Z_total);
    });

    const R_acum = [0];
    let R_parcial = 0;
    camadas.forEach(c => {
      R_parcial += c.R;
      R_acum.push(R_parcial);
    });

    for (let m = 0; m < 12; m++) {
      const [Te, HRe, diasMes] = CLIMA[zona][m];

      // Condensação superficial
      const theta_si = Ti - (Rsi / R_total) * (Ti - Te);
      const f_Rsi = (theta_si - Te) / (Ti - Te);
      const T_dew = pontoOrvalho(Ti, HRi);
      const f_Rsi_crit = (T_dew - Te) / (Ti - Te);
      if (f_Rsi < f_Rsi_crit) {
        condSupMeses.push(meses[m]);
        diasSup += diasMes;
      }

      // Condensação intersticial — não aplicável a pavimento_solo
      if (!avisoSolo) {
        const p_i = HRi * pSat(Ti);
        const p_e = HRe * pSat(Te);
        const n = camadas.length;

        // Temperature and psat at each interface
        const psat_pts = [];
        for (let j = 0; j <= n; j++) {
          const theta_j = Ti - (Ti - Te) * (R_acum[j] / R_total);
          psat_pts.push(pSat(theta_j));
        }

        // Glaser with clamping: forward pass from interior to exterior
        // After condensation at interface j, use psat[j] as new left boundary
        let p_left = p_i;
        let Z_left = 0;
        let houveCondNesteMes = false;

        for (let j = 1; j < n; j++) {
          const Z_j = Z_acum[j];
          const Z_remaining = Z_total - Z_left;
          if (Z_remaining <= 0) continue;

          // Vapor pressure at interface j (linear from current left boundary to p_e)
          const p_j_linear = p_left - (p_left - p_e) * ((Z_j - Z_left) / Z_remaining);

          if (p_j_linear > psat_pts[j]) {
            // Condensation at interface j
            const Z_seg_before = Z_j - Z_left;
            const Z_seg_after = Z_total - Z_j;
            const g_in  = Z_seg_before > 0 ? (p_left - psat_pts[j]) / Z_seg_before : 0;
            const g_out = Z_seg_after  > 0 ? (psat_pts[j] - p_e) / Z_seg_after : 0;
            const g_cond = Math.max(0, g_in - g_out); // kg/(m²·s)

            if (g_cond > 0) {
              const ifaceName = `${camadas[j-1].material} / ${camadas[j].material}`;
              houveCondNesteMes = true;
              interfacesCriticas.add(ifaceName);
              // Monthly condensate in g/m²
              const Mc = g_cond * diasMes * 86400 * 1000;
              condensadoAnual[ifaceName] = (condensadoAnual[ifaceName] || 0) + Mc;
              // Clamp: update left boundary for next interface
              p_left = psat_pts[j];
              Z_left = Z_j;
            }
          }
        }

        if (houveCondNesteMes) {
          condIntMeses.push(meses[m]);
          diasInt += diasMes;
        }
      }
    }

    let severidadeSup = 'Baixa';
    if (diasSup > 60) severidadeSup = 'Alta';
    else if (diasSup > 30) severidadeSup = 'Média';

    let severidadeInt = 'Baixa';
    if (diasInt > 60) severidadeInt = 'Alta';
    else if (diasInt > 30) severidadeInt = 'Média';

    if (!fromBiblioteca) {
      const resumo = document.getElementById('resultadoResumo');
      resumo.innerHTML = `
        <p><strong>${escHTML(nome)}</strong> (${tipo}, Zona ${zona})</p>
        <p>U = ${U.toFixed(3)} W/m²K &nbsp; | &nbsp;
           U_lim(REH) = ${U_lim.toFixed(2)} W/m²K &nbsp;
           <span class="badge ${badgeClass}">${classe}</span></p>
        <p>R_total = ${R_total.toFixed(2)} m²K/W &nbsp; | &nbsp;
           Camadas: ${camadas.length} &nbsp; | &nbsp;
           T<sub>i</sub> = ${Ti} °C, HR<sub>i</sub> = ${Math.round(HRi*100)} %</p>
        <p>Condensação superficial: ${condSupMeses.length ? 'Sim ('+condSupMeses.join(', ')+')' : 'Não'} &nbsp; | &nbsp;
           Condensação intersticial: ${avisoSolo ? 'N/A (pavimento solo)' : (condIntMeses.length ? 'Sim ('+condIntMeses.join(', ')+')' : 'Não')}</p>
        ${avisoSolo ? '<p style="color:var(--warn);font-size:0.85rem;margin-top:0.5rem;">⚠️ Pavimento sobre solo: o cálculo de U por ISO 6946 é uma aproximação — para resultado normativo use ISO 13370. A análise higrotérmica intersticial não é aplicável a este tipo de elemento.</p>' : ''}
      `;
    }

    simulacoes.push({
      nome, tipo, zona, U, R_total, camadas,
      condSupMeses, condIntMeses,
      diasSup, diasInt,
      severidadeSup, severidadeInt,
      interfacesCriticas: Array.from(interfacesCriticas),
      condensadoAnual,
      avisoSolo,
      origemBiblioteca: fromBiblioteca
    });
    contadorElementos++;
    renderPizzaGrid();

    if (!fromBiblioteca) {
      verificarSugestaoBiblioteca({ nome, tipo, zona, U, camadas });
    }
  }

