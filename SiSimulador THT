        nome: "Pavimento misto com EPS inferior (tipo SCE/ADENE)",
        camadas: [
          { material: "Acabamento 20mm", lambda: 1.00, mu: 20, d: 0.02 },
          { material: "Laje 160mm", lambda: 1.40, mu: 50, d: 0.16 },
          { material: "EPS 60mm", lambda: 0.035, mu: 30, d: 0.06 }
        ]
      }
    ]
  };

  let simulacoes = [];
  let contadorElementos = 0;
  let chartInstances = {};
  const MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function definirCamadas() {
    const n = parseInt(document.getElementById('numCamadas').value || '0', 10);
    const container = document.getElementById('camadasContainer');
    container.innerHTML = '';
    if (n <= 0) return;
    for (let i = 0; i < n; i++) {
      const div = document.createElement('div');
      div.className = 'row';
      div.innerHTML = `
        <div>
          <label>Material camada ${i+1}</label>
          <input data-camada="${i}" data-tipo="material" placeholder="Ex.: Tijolo, EPS">
        </div>
        <div>
          <label>λ${i+1} [W/m·K]</label>
          <input data-camada="${i}" data-tipo="lambda" type="number" step="0.001">
        </div>
        <div>
          <label>μ${i+1} [-]</label>
          <input data-camada="${i}" data-tipo="mu" type="number" step="0.1">
        </div>
        <div>
          <label>d${i+1} [mm]</label>
          <input data-camada="${i}" data-tipo="esp" type="number" step="1">
        </div>
      `;
      container.appendChild(div);
    }
  }

  function calcularElemento(fromBiblioteca = false, bibliotecaEntry = null) {
    let tipo, zona, nome, camadas;

    if (!fromBiblioteca) {
      tipo = document.getElementById('tipoElemento').value;
      zona = document.getElementById('zonaClimatica').value;
      nome = document.getElementById('nomeElemento').value || 'Elemento sem nome';
      const n = parseInt(document.getElementById('numCamadas').value || '0', 10);
      const msgEl = document.getElementById('inputValidacaoMsg');
      msgEl.style.display = 'none';

      if (n <= 0 || n > 20) {
        msgEl.textContent = 'Indique um número de camadas válido (1–20).';
        msgEl.style.display = 'block';
        return;
      }

      const inputs = document.querySelectorAll('#camadasContainer input');
      camadas = [];
      for (let i = 0; i < n; i++) {
        const material = [...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'material').value || `Camada ${i+1}`;
        const lambda = parseFloat([...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'lambda').value || '0');
        const mu = parseFloat([...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'mu').value || '1');
        const esp_mm = parseFloat([...inputs].find(el => el.dataset.camada == i && el.dataset.tipo === 'esp').value || '0');
        const d = esp_mm / 1000;
        if (lambda <= 0 || d <= 0) continue;
        const R = d / lambda;
        camadas.push({ material, lambda, mu, d, R });
      }
      if (!camadas.length) {
        msgEl.textContent = 'Preencha pelo menos uma camada com λ > 0 e espessura > 0.';
        msgEl.style.display = 'block';
        return;
      }
    } else {
      tipo = bibliotecaEntry.tipo;
      zona = document.getElementById('zonaClimatica').value;
      nome = bibliotecaEntry.nome;
      camadas = bibliotecaEntry.camadas.map(c => ({
        material: c.material,
        lambda: c.lambda,
        mu: c.mu,
        d: c.d,
        R: c.d / c.lambda
      }));
    }

    const { Rsi, Rse } = R_SUP[tipo];
    const R_total = Rsi + camadas.reduce((s,c)=>s+c.R,0) + Rse;
    const U = 1 / R_total;
    const U_lim = U_LIMITES[tipo][zona];

    let classe = '';
    let badgeClass = '';
    if (U <= U_lim) { classe = 'Conforme REH'; badgeClass = 'ok'; }
    else if (U <= 0.50) { classe = 'Melhorável'; badgeClass = 'warn'; }
    else { classe = 'Não conforme (existente típico)'; badgeClass = 'danger'; }

    // Condições interiores (lidas dos inputs; defaults 20°C / 50%)
    const Ti = parseFloat(document.getElementById('inputTi').value) || 20;
    const HRi = Math.min(100, Math.max(0, parseFloat(document.getElementById('inputHRi').value) || 50)) / 100;

    const soloNaoAplicavel = (tipo === 'pavimento_solo');
    let condSupMeses = [];
    let condIntMeses = [];
    let interfacesCriticas = new Set();
    let diasSup = 0;
    let diasInt = 0;
    let monthlyCondData = []; // g/m²·mês (+ condensação, - evaporação)
    let annualNetKg = 0;      // kg/m²·ano acumulado líquido

    if (!soloNaoAplicavel) {
      for (let m = 0; m < 12; m++) {
        const [Te, HRe, diasMes] = CLIMA[zona][m];

        // Condensação superficial
        const theta_si = Ti - (Rsi / R_total) * (Ti - Te);
        // When Ti = Te there is no thermal gradient; default both factors to 0 → no condensation flagged (correct behaviour)
        const f_Rsi = (Ti - Te) !== 0 ? (theta_si - Te) / (Ti - Te) : 0;
        const T_dew = pontoOrvalho(Ti, HRi);
        const f_Rsi_crit = (Ti - Te) !== 0 ? (T_dew - Te) / (Ti - Te) : 0;
        if (f_Rsi < f_Rsi_crit) {
          condSupMeses.push(MESES[m]);
          diasSup += diasMes;
        }

        // Condensação intersticial – Glaser ISO 13788 melhorado
        const p_i_m = HRi * pSat(Ti);
        const p_e_m = HRe * pSat(Te);

        let Z_acum = [0];
        let Z_total = 0;
        camadas.forEach(c => {
          const Zi = c.mu * c.d / DELTA_0;
          Z_total += Zi;
          Z_acum.push(Z_total);
        });

        let R_acum = [0];
        let R_parcial = 0;
        camadas.forEach(c => {
          R_parcial += c.R;
          R_acum.push(R_parcial);
        });

        // 1ª passagem: encontrar interface crítica (maior excesso p - p_sat)
        let maxExcess = 0, critJ = -1;
        if (Z_total > 0) {
          for (let j = 1; j < Z_acum.length; j++) {
            const px = p_i_m - (p_i_m - p_e_m) * (Z_acum[j] / Z_total);
            const thetax = Ti - (Ti - Te) * (R_acum[j] / R_total);
            const psatx = pSat(thetax);
            const excess = px - psatx;
            if (excess > maxExcess) { maxExcess = excess; critJ = j; }
          }
        }

        // 2ª passagem: perfil com clamp na interface crítica
        let houveCondIntNesteMes = false;
        for (let j = 1; j < Z_acum.length; j++) {
          let px;
          if (critJ < 0 || Z_total === 0) {
            px = p_i_m - (p_i_m - p_e_m) * (Z_acum[j] / Z_total);
          } else {
            const psatCrit = pSat(Ti - (Ti - Te) * (R_acum[critJ] / R_total));
            if (j <= critJ) {
              px = Z_acum[critJ] > 0
                ? p_i_m - (p_i_m - psatCrit) * (Z_acum[j] / Z_acum[critJ])
                : p_i_m;
            } else {
              const Zrem = Z_total - Z_acum[critJ];
              px = Zrem > 0
                ? psatCrit - (psatCrit - p_e_m) * ((Z_acum[j] - Z_acum[critJ]) / Zrem)
                : psatCrit;
            }
          }
          const thetax = Ti - (Ti - Te) * (R_acum[j] / R_total);
          const psatx = pSat(thetax);
          if (px > psatx) {
            houveCondIntNesteMes = true;
            interfacesCriticas.add(`${camadas[j-1].material} / ${camadas[j]?.material || 'exterior'}`);
          }
        }

        // Fluxo de condensado/evaporação (kg/m²·mês) na interface crítica
        let g_month_kg = 0;
        if (critJ >= 0 && Z_total > 0) {
          const psatJ = pSat(Ti - (Ti - Te) * (R_acum[critJ] / R_total));
          const Zin  = Z_acum[critJ];
          const Zout = Z_total - Z_acum[critJ];
          const g_in  = Zin  > 0 ? (p_i_m - psatJ) / Zin  : 0;
          const g_out = Zout > 0 ? (psatJ - p_e_m) / Zout : 0;
          const g_net = g_in - g_out; // + = condensação, - = evaporação
          g_month_kg = g_net * diasMes * 86400;
          if (g_net > 0) houveCondIntNesteMes = true;
        }
        monthlyCondData.push(+(g_month_kg * 1000).toFixed(1));
        annualNetKg += g_month_kg;

        if (houveCondIntNesteMes) {
          condIntMeses.push(MESES[m]);
          diasInt += diasMes;
        }
      }
    }

    let severidadeSup = 'Baixa';
    if (diasSup > 60) severidadeSup = 'Alta';
    else if (diasSup > 30) severidadeSup = 'Média';

    let severidadeInt = 'Baixa';
    if (diasInt > 60) severidadeInt = 'Alta';
    else if (diasInt > 30) severidadeInt = 'Média';

    if (!fromBiblioteca) {
      const resumo = document.getElementById('resultadoResumo');
      const nomeEsc = escapeHtml(nome);
      const tipoEsc = escapeHtml(tipo);
      const zonaEsc = escapeHtml(zona);
      const classeEsc = escapeHtml(classe);
      const soloAviso = soloNaoAplicavel
        ? `<p style="color:var(--warn)">⚠ U(ISO 6946) = ${U.toFixed(3)} W/m²K é apenas uma aproximação — o cálculo regulamentar para pavimento sobre solo requer ISO 13370.</p>`
        : '';
      const condSupTxt = !soloNaoAplicavel
        ? (condSupMeses.length ? 'Sim (' + escapeHtml(condSupMeses.join(', ')) + ')' : 'Não')
        : '<em>N/A (solo)</em>';
      const condIntTxt = !soloNaoAplicavel
        ? (condIntMeses.length ? 'Sim (' + escapeHtml(condIntMeses.join(', ')) + ')' : 'Não')
        : '<em>N/A (solo)</em>';
      resumo.innerHTML =
        `<p><strong>${nomeEsc}</strong> (${tipoEsc}, Zona ${zonaEsc})</p>` +
        `<p>U = ${U.toFixed(3)} W/m²K &nbsp; | &nbsp;` +
        `U_lim(REH) = ${U_lim.toFixed(2)} W/m²K &nbsp;` +
        `<span class="badge ${badgeClass}">${classeEsc}</span></p>` +
        soloAviso +
        `<p>R_total = ${R_total.toFixed(2)} m²K/W &nbsp; | &nbsp;` +
        `Camadas: ${camadas.length}</p>` +
        `<p>Condensação superficial: ${condSupTxt} &nbsp; | &nbsp;` +
        `Condensação intersticial: ${condIntTxt}</p>`;
    }

    simulacoes.push({
      nome, tipo, zona, U, R_total, camadas,
      condSupMeses, condIntMeses,
      diasSup, diasInt,
      severidadeSup, severidadeInt,
      interfacesCriticas: Array.from(interfacesCriticas),
      origemBiblioteca: fromBiblioteca,
      soloNaoAplicavel,
      monthlyCondData,
      annualNetKg
    });
    contadorElementos++;
    renderPizzaGrid();

    if (!fromBiblioteca) {
      verificarSugestaoBiblioteca({ nome, tipo, zona, U, camadas });
    }
  }

  function limparAtual() {
    document.getElementById('camadasContainer').innerHTML = '';
    document.getElementById('resultadoResumo').innerText =
      'Selecione o tipo de elemento, zona climática e defina as camadas para calcular U e o risco de condensação.';
  }

  // Magnus–Tetens (T em °C, RH em fração 0–1)
  function pontoOrvalho(T, RH) {
    const a = 17.27, b = 237.7;
    const gamma = (a * T) / (b + T) + Math.log(RH);
    return (b * gamma) / (a - gamma);
  }

  // Pressão de vapor de saturação (Pa)
  function pSat(T) {
    const Tc = T;
    return 610.78 * Math.exp((17.27 * Tc) / (Tc + 237.3));
  }

  function renderPizzaGrid() {
    // Destroy existing Chart.js instances before clearing DOM
    Object.values(chartInstances).forEach(c => { try { c.destroy(); } catch(e) { console.warn('Chart destroy failed:', e); } });
    chartInstances = {};

    const grid = document.getElementById('pizzaGrid');
    grid.innerHTML = '';
    const k = simulacoes.length;
    if (!k) return;
    const n = Math.ceil(k / 3) * 3;

    for (let i = 0; i < n; i++) {
      const cell = document.createElement('div');
      cell.className = 'pizza-cell';
      if (i < k) {
        const sim = simulacoes[i];
        const origem = sim.origemBiblioteca ? ' (tipo SCE/ADENE)' : '';
        const titleEl = document.createElement('div');
        titleEl.className = 'pizza-title';
        titleEl.textContent = sim.nome + origem + ' — ' + sim.tipo + ', Zona ' + sim.zona;

        const chartsRow = document.createElement('div');
        chartsRow.className = 'charts-row';

        const canvas = document.createElement('canvas');
        canvas.id = 'pizzaU_' + i;

        const svgWrap = document.createElement('div');
        svgWrap.className = 'svg-wrapper';
        svgWrap.id = 'svg_' + i;

        chartsRow.appendChild(canvas);
        chartsRow.appendChild(svgWrap);

        const noteEl = document.createElement('div');
        noteEl.className = 'higro-note';
        noteEl.id = 'note_' + i;

        const creditEl = document.createElement('div');
        creditEl.className = 'credit';
        creditEl.textContent = 'Tulio Cunha — Gestão de Projetos';

        cell.appendChild(titleEl);
        cell.appendChild(chartsRow);
        cell.appendChild(noteEl);
        cell.appendChild(creditEl);
        grid.appendChild(cell);

        desenharPizzaU('pizzaU_' + i, sim);
        desenharSVG('svg_' + i, sim);
        escreverNotaHigro('note_' + i, sim);
      } else {
        const slotEl = document.createElement('div');
        slotEl.className = 'pizza-title';
        slotEl.textContent = 'Slot disponível';
        cell.appendChild(slotEl);
        grid.appendChild(cell);
      }
    }
  }

  function desenharPizzaU(canvasId, sim) {
    const ctx = document.getElementById(canvasId).getContext('2d');
    const U_lim = U_LIMITES[sim.tipo][sim.zona];
    const data = {
      labels: ['U calculado', 'Limite REH'],
      datasets: [{
        data: [sim.U, U_lim],
        backgroundColor: ['#1f6f8b', '#a5d8ff']
      }]
    };
    chartInstances[canvasId] = new Chart(ctx, {
      type: 'pie',
      data,
      options: {
        plugins: { legend: { display: false } },
        responsive: true,
        maintainAspectRatio: false
      }
    });
  }

  function desenharSVG(containerId, sim) {
    const container = document.getElementById(containerId);
    const vertical = (sim.tipo === 'parede' || sim.tipo === 'cobertura');
    const width = 220, height = 220;
    const totalEsp = sim.camadas.reduce((s,c)=>s+c.d,0);
    let offset = 0;
    let rects = '';

    sim.camadas.forEach((c, idx) => {
      const frac = c.d / totalEsp;
      const matEsc = escapeHtml(c.material);

      if (vertical) {
        const h = frac * (height - 40);
        rects += `
          <rect x="40" y="${20 + offset}" width="${width - 80}" height="${h}"
                fill="none" stroke="#111" stroke-width="1"/>
          <text x="45" y="${20 + offset + h/2}" font-size="9" fill="#111">
            ${matEsc} — ${(c.d*1000).toFixed(0)} mm
          </text>
        `;
        offset += h;
      } else {
        const w = frac * (width - 80);
        rects += `
          <rect x="${40 + offset}" y="60" width="${w}" height="${height - 120}"
                fill="none" stroke="#111" stroke-width="1"/>
          <text x="${40 + offset + w/2}" y="55" font-size="9" fill="#111" text-anchor="middle">
            ${(c.d*1000).toFixed(0)} mm
          </text>
        `;
        offset += w;
      }
    });

    const escala = `
      <line x1="40" y1="${height-10}" x2="${width-40}" y2="${height-10}"
            stroke="#111" stroke-width="1"/>
      <text x="${width/2}" y="${height-2}" font-size="9" fill="#111" text-anchor="middle">
        Escala proporcional às espessuras
      </text>
    `;

    const svg = `
      <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}"
           xmlns="http://www.w3.org/2000/svg">
        <rect x="0.5" y="0.5" width="${width-1}" height="${height-1}"
              fill="none" stroke="#e5e7eb" stroke-width="1"/>
        ${rects}
        ${escala}
        <text x="${width-5}" y="${height-5}" font-size="7" fill="#999" text-anchor="end">
          Tulio Cunha — Gestão de Projetos
        </text>
      </svg>
    `;

    container.innerHTML = svg;
  }

  function escreverNotaHigro(noteId, sim) {
    const el = document.getElementById(noteId);
    el.innerHTML = '';

    if (sim.soloNaoAplicavel) {
      const warn = document.createElement('p');
      warn.style.cssText = 'color:var(--warn);margin:0;font-weight:500;';
      warn.textContent = '⚠ Análise higrotérmica: NÃO APLICÁVEL para pavimento sobre solo.';
      const detail = document.createElement('p');
      detail.style.cssText = 'margin:0.25rem 0 0;';
      detail.textContent = 'O terreno não é equivalente a ar exterior — a análise de Glaser pressupõe condições de ar em ambas as faces. Para este tipo de elemento use metodologia específica (ISO 13370 / regulamentação nacional). O U(ISO 6946) calculado é apenas uma aproximação.';
      el.appendChild(warn);
      el.appendChild(detail);
      return;
    }

    const supMeses = sim.condSupMeses.length ? escapeHtml(sim.condSupMeses.join(', ')) : 'Nenhum';
    const intMeses = sim.condIntMeses.length ? escapeHtml(sim.condIntMeses.join(', ')) : 'Nenhum';
    const interfaces = sim.interfacesCriticas.length
      ? sim.interfacesCriticas.map(escapeHtml).join(' | ')
      : 'Nenhuma interface crítica identificada';

    const condTable = sim.monthlyCondData && sim.monthlyCondData.length === 12
      ? '<br>• Condensado/Evaporação (g/m²·mês): ' +
        MESES.map((mes, i) => {
          const val = sim.monthlyCondData[i];
          const color = val > 0 ? 'color:var(--danger)' : val < 0 ? 'color:var(--ok)' : '';
          return `<span style="${color}">${escapeHtml(mes)}:${val > 0 ? '+' : ''}${val}</span>`;
        }).join(' ')
      : '';

    const annualNetG = sim.annualNetKg !== undefined ? +(sim.annualNetKg * 1000).toFixed(1) : null;
    const annualTxt = annualNetG !== null
      ? `<br>• Balanço anual: <strong style="color:${annualNetG > 50 ? 'var(--danger)' : annualNetG > 0 ? 'var(--warn)' : 'var(--ok)'}">${annualNetG > 0 ? '+' : ''}${annualNetG} g/m²·ano</strong>` +
        (annualNetG > 50 ? ' ⚠ Acumulação significativa — verificar selagem e barreira de vapor.' : '')
      : '';

    el.innerHTML =
      `<strong>Análise higrotérmica (ISO 13788, Glaser):</strong><br>` +
      `• Superficial: ${sim.condSupMeses.length ? 'Sim' : 'Não'} (${supMeses})<br>` +
      `• Intersticial: ${sim.condIntMeses.length ? 'Sim' : 'Não'} (${intMeses})<br>` +
      `• Interfaces críticas: ${interfaces}` +
      condTable +
      annualTxt + `<br>` +
      `• Dias risco superficial: ${sim.diasSup} dias/ano (${escapeHtml(sim.severidadeSup)})<br>` +
      `• Dias risco intersticial: ${sim.diasInt} dias/ano (${escapeHtml(sim.severidadeInt)})`;
  }

  // --- Biblioteca: sugestão automática ---

  function verificarSugestaoBiblioteca(elementoBase) {
    if (contadorElementos === 1 || contadorElementos % 6 === 0) {
      const candidatos = filtrarBiblioteca(elementoBase);
      if (candidatos.length) {
        const box = document.getElementById('bibliotecaSugestao');
        const select = document.getElementById('bibliotecaSelect');
        select.innerHTML = '';
        candidatos.forEach((c, idx) => {
          const opt = document.createElement('option');
          opt.value = idx;
          opt.textContent = c.nome;
          select.appendChild(opt);
        });
        box.dataset.tipo = elementoBase.tipo;
        box.dataset.candidatos = JSON.stringify(candidatos);
        box.style.display = 'block';
      }
    }
  }

  function filtrarBiblioteca(elementoBase) {
    const tipo = elementoBase.tipo;
    const lista = BIBLIOTECA[tipo] || [];
    if (!lista.length) return [];

    const espUser = elementoBase.camadas.reduce((s,c)=>s+c.d,0);
    const materiaisUser = elementoBase.camadas.map(c => c.material.toLowerCase());

    return lista.filter(sol => {
      const espSol = sol.camadas.reduce((s,c)=>s+c.d,0);
      const ratioEsp = espSol / espUser;
      if (ratioEsp < 0.8 || ratioEsp > 1.2) return false;

      const materiaisSol = sol.camadas.map(c => c.material.toLowerCase());
      const temMaterialSimilar = materiaisSol.some(m =>
        materiaisUser.some(mu => mu.includes('eps') && m.includes('eps')) ||
        materiaisUser.some(mu => mu.includes('lã') && m.includes('lã')) ||
        materiaisUser.some(mu => mu.includes('tijolo') && m.includes('tijolo')) ||
        materiaisUser.some(mu => mu.includes('betão') && m.includes('betão'))
      );

      return temMaterialSimilar;
    });
  }

  function adicionarDaBiblioteca() {
    const box = document.getElementById('bibliotecaSugestao');
    const select = document.getElementById('bibliotecaSelect');
    const idx = parseInt(select.value || '0', 10);
    const candidatos = JSON.parse(box.dataset.candidatos || '[]');
    const sol = candidatos[idx];
    if (!sol) return;
    calcularElemento(true, { tipo: box.dataset.tipo, nome: sol.nome, camadas: sol.camadas });
    box.style.display = 'none';
  }

  function fecharSugestao() {
    document.getElementById('bibliotecaSugestao').style.display = 'none';
  }
</script>
