<div class="app">
  <div class="toolbar">
    <button class="secondary" onclick="window.print()">Exportar PDF</button>
  </div>

  <h1>Avaliação térmica e higrotérmica de elementos opacos</h1>
  <p class="subtitle">
    Compatível com REH (DL 101‑D/2020, Portaria 138‑I/2021) – U‑value + risco de condensação (ISO 6946 + ISO 13788)
    e biblioteca de soluções tipo SCE/ADENE.
  </p>

  <div class="grid grid-2">
    <!-- Painel de entrada -->
    <div class="card">
      <div class="card-header">
        <h2>Configuração do elemento</h2>
        <span>Definição de camadas</span>
      </div>

      <div class="row">
        <div>
          <label>Tipo de elemento</label>
          <select id="tipoElemento">
            <option value="parede">Parede exterior</option>
            <option value="cobertura">Cobertura</option>
            <option value="pavimento_solo">Pavimento sobre solo</option>
            <option value="pavimento_nu">Pavimento sobre espaço não útil</option>
          </select>
        </div>
        <div>
          <label>Zona climática</label>
          <select id="zonaClimatica">
            <option value="I">Zona I</option>
            <option value="II">Zona II</option>
            <option value="III">Zona III</option>
            <option value="IV">Zona IV</option>
          </select>
        </div>
      </div>

      <div class="row">
        <div>
          <label>Nome do elemento</label>
          <input id="nomeElemento" placeholder="Ex.: Parede ETICS 20cm">
        </div>
        <div>
          <label>Nº de camadas</label>
          <input id="numCamadas" type="number" min="1" value="3">
        </div>
      </div>

      <div class="row">
        <div>
          <label>Ti [°C] (temperatura interior)</label>
          <input id="inputTi" type="number" step="0.5" value="20">
        </div>
        <div>
          <label>HRi [%] (humidade relativa interior)</label>
          <input id="inputHRi" type="number" step="1" min="0" max="100" value="50">
        </div>
      </div>
      <div id="inputValidacaoMsg" style="color:var(--danger);font-size:0.8rem;margin-bottom:0.4rem;display:none;"></div>

