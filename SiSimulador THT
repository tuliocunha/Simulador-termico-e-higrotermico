      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 0.5rem;
    }
    .card-header span {
      font-size: 0.8rem;
      color: var(--text-soft);
    }
    label {
      display: block;
      font-size: 0.85rem;
      margin-bottom: 0.25rem;
      color: var(--text-soft);
    }
    select, input {
      width: 100%;
      padding: 0.4rem 0.5rem;
      border-radius: 6px;
      border: 1px solid #d1d5db;
      font-size: 0.9rem;
      margin-bottom: 0.6rem;
      background: #f9fafb;
    }
    button {
      border: none;
      border-radius: 999px;
      padding: 0.45rem 1.1rem;
      font-size: 0.9rem;
      cursor: pointer;
      background: var(--accent);
      color: white;
      font-weight: 500;
    }
    button.secondary {
      background: transparent;
      border: 1px solid var(--accent);
      color: var(--accent);
    }
    .row {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .row > div {
      flex: 1 1 120px;
    }
    .badge {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 500;
    }
    .badge.ok { background: #dcfce7; color: var(--ok); }
    .badge.warn { background: #fef3c7; color: var(--warn); }
    .badge.danger { background: #fee2e2; color: var(--danger); }
    .pizza-matrix {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    @media (max-width: 800px) {
      .pizza-matrix {
        grid-template-columns: 1fr;
      }
    }
    .pizza-cell {
      background: var(--card);
      border-radius: 10px;
      padding: 0.75rem;
      box-shadow: 0 6px 16px rgba(15, 23, 42, 0.05);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .pizza-title {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--text-soft);
    }
    .charts-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      align-items: center;
    }
    .svg-wrapper {
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      padding: 0.25rem;
      background: #ffffff;
    }
    .higro-note {
      font-size: 0.8rem;
      color: var(--text-soft);
      line-height: 1.4;
    }
    .credit {
      font-size: 0.7rem;
      text-align: right;
      color: #9ca3af;
      margin-top: 0.15rem;
    }
    table {
